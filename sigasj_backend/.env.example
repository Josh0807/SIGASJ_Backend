# Copia este archivo a .env y completa los valores.
# El archivo .env no se sube al repositorio.

DB_ENABLED=true

# windows = autenticación de Windows / LocalDB (como Azure Data Studio)
# sql     = usuario y contraseña SQL Server
DB_AUTH=windows

# Azure Data Studio / LocalDB
DB_HOST=(localdb)\MSSQLLocalDB
# Base de aplicación SIGASJ (no usar master)
DB_DATABASE=SIGASJ

# Solo si DB_AUTH=sql
# DB_PORT=1433
# DB_USERNAME=sa
# DB_PASSWORD=

# Encrypt Mandatory en ADS → true
# Trust Server Certificate: en Node/LocalDB suele hacer falta true
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server

DB_SYNCHRONIZE=false
DB_LOGGING=false
PORT=3000

# JWT (requerido para rutas /api/admin/*)
JWT_SECRET=cambiar-por-un-secreto-largo-y-seguro
JWT_EXPIRES_IN=8h

# Galería — almacenamiento local de imágenes (uploads/galeria)
# Las URLs públicas se sirven bajo /uploads/galeria/{archivo}

# Transparencia — documentos e imágenes (uploads/transparencia)
# Las URLs públicas se sirven bajo /uploads/transparencia/{archivo}
