# Copia este archivo a .env y completa los valores.
# El archivo .env no se sube al repositorio.

DB_ENABLED=true

# windows = autenticación de Windows / LocalDB (como Azure Data Studio)
# sql     = usuario y contraseña SQL
DB_AUTH=windows

# Azure Data Studio: (localdb)\MSSQLLocalDB
DB_HOST=(localdb)\MSSQLLocalDB
# Base de aplicación SIGASJ (no usar master)
DB_DATABASE=SIGASJ

# Solo si DB_AUTH=sql
# DB_PORT=1433
# DB_USERNAME=sa
# DB_PASSWORD=

# Encrypt Mandatory en ADS → true
# Trust Server Certificate: en Node/LocalDB suele hacer falta true
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server

DB_SYNCHRONIZE=false
DB_LOGGING=false
PORT=3000
